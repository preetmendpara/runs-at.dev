.next/
.env*.local
.vercel
.DS_Store
tab-setup.txt
server.log
cr.json

# Local git worktrees. These are checkouts, never repo content — and without
# this they are also uploaded by `vercel deploy`, which reads .gitignore and
# has no .vercelignore here. That was 383MB of other sessions' working copies
# heading into a deployment that would then serve them for as long as the
# deployment URL exists.
worktrees/

# Raw Cloudflare zone exports (origin targets of proxied records); keep local.
migration/backup/cloudflare/
# Migration outputs: backups, raw and live DNS exports, generated zone files
# and record-level reports stay local. Only scripts and sanitized docs are
# tracked. Regenerate with the scripts under migration/ and scripts/.
migration/backup/
migration/zone/
migration/reports/
migration/operator-extra.json
